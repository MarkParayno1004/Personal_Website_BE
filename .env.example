# Required
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/personal_portfolio
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-bytes

# development | production (production disables /docs and enables HSTS/CSP)
APP_ENV=development

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
GITHUB_USERNAME=MarkParayno1004
GITHUB_TOKEN=

# File storage: Cloudflare R2 (S3-compatible). Leave unset to store files on local disk (dev/tests).
# Profile pictures go to R2_BUCKET and are served from R2_PUBLIC_BASE_URL (r2.dev URL or custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# CVs are private. Use a second bucket WITHOUT public access; defaults to R2_BUCKET if unset.
R2_PRIVATE_BUCKET=

# Email (verification + password reset) via Resend. Leave RESEND_API_KEY unset to log emails instead (dev only).
RESEND_API_KEY=
EMAIL_FROM=Portfolio <onboarding@resend.dev>
# Base URL of the frontend; used to build /verify-email and /reset-password links
FRONTEND_URL=http://localhost:5173
